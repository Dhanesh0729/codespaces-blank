import React, {useState, useEffect, useLayoutEffect, useRef, useMemo} from 'react';
import {createRoot} from 'react-dom/client';
import {Keyboard, BarChart3, Palette, Settings, Sun, Moon, Volume2, VolumeX, ChevronDown, ArrowUpRight, RotateCcw, ArrowRight, Sparkles, Flame, Target, Zap, Clock3, Check, X, Download, Upload, Trophy, Command, BookOpen, Maximize2, Heart, Github, Coffee} from 'lucide-react';
import './styles.css';
import {useSessionClock,timeExpired,buildTimeline,idleRemaining} from './session';
import {MatchAnalytics} from './MatchAnalytics';
import {COMPANION_DEFAULTS,companionName,companionStyle,getCompanionReaction} from './companion';
import {CompanionStudio,CompanionDetails,CompanionFace} from './Companion.jsx';
import {DivineCostume} from './CompanionDivine';
const KineticText=({text})=>text;
// GOD_MODE_INTEGRATION: isolated feature; selective reversal recorded in .feature-backups/god-mode.
const useGodMode=()=>({active:false,previewing:false,power:0,baseline:40,threshold:52});
const GOD_MODE_PALETTE={};const GodModeControl=()=>null;const GodModeEffects=()=>null;const playGodKey=()=>{};

const WORDS='the world is full of little things that make each day a new adventure take a moment to find your own rhythm and let your thoughts flow like water through a quiet forest every small step brings you closer to the person you want to become keep going and trust the process there is magic in the way we learn something new with time and patience you can build a life filled with wonder create a space for yourself to dream big and start small'.split(' ');
const QUOTES=['Somewhere, something incredible is waiting to be known. The beautiful thing about learning is that nobody can take it away from you.', 'You do not have to see the whole staircase. Just take the first step. Every journey begins with the courage to try something new.', 'Life moves pretty fast. If you do not stop and look around once in a while, you could miss it. Find the joy in the little things.'];
const THEMES=[{id:'lavender',name:'Lavender mist',sub:'A little room to breathe',color:'#a393da',bg:'#f5f3fa',panel:'#ffffff',text:'#363344'}, {id:'glass',name:'Liquid glass',sub:'Soft light, fluid focus',color:'#7dace2',bg:'#e8f0f9',panel:'#ffffffaa',text:'#304360'}, {id:'batman',name:'Gotham night',sub:'Your focus is your superpower',color:'#e9c748',bg:'#17191d',panel:'#22252b',text:'#e7e6e1'}, {id:'neon',name:'Neon dreams',sub:'After hours in the city',color:'#e578e9',bg:'#20172d',panel:'#2c203b',text:'#f0e3fc'}, {id:'hacker',name:'Terminal',sub:'Enter the flow state',color:'#70df9b',bg:'#111c18',panel:'#192a21',text:'#c3e9ce'}, {id:'iron',name:'Arc reactor',sub:'Built for a little brilliance',color:'#58cfdf',bg:'#25191b',panel:'#352226',text:'#f6e5e2'}, {id:'paper',name:'Paper & ink',sub:'Simple, thoughtful, timeless',color:'#e79465',bg:'#f4efe5',panel:'#fffdf6',text:'#494437'}, {id:'ghibli',name:'Forest daydream',sub:'A breeze through the trees',color:'#83a783',bg:'#eff1e7',panel:'#fbfcf4',text:'#3e5142'}, {id:'retro',name:'Retro arcade',sub:'Insert coin. Find your rhythm.',color:'#e6ac66',bg:'#28223b',panel:'#352e49',text:'#eee3cf'}, {id:'3d',name:'Cloud nine',sub:'A softer dimension',color:'#8d9fe4',bg:'#e9edf9',panel:'#f6f8ff',text:'#434967'}, {id:'shounen',name:'Shōnen spirit',sub:'Your training arc starts here',color:'#f29a66',bg:'#fff1e8',panel:'#fffaf5',text:'#593c3c'}];
const SOUNDS=['Off','Mechanical','Bubble pop','Dark coder','Retro arcade','Shōnen','Soft rain'];
const read=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key))??fallback}catch{return fallback}};
const initialSettings={...COMPANION_DEFAULTS,theme:'lavender',dark:false,sound:'Mechanical',volume:35,buddy:true,roast:false,keyboard:true,accent:'',punctuation:false,numbers:false};
function Mascot({mood='idle',typing=false,small=false,mouse={x:0,y:0},mousing=false,godMode=false,preferences={}}){if(preferences.buddyMotion===false){typing=false;mousing=false;mouse={x:0,y:0};}return <svg className={`mascot mood-${mood} ${typing?'is-typing':''} ${small?'small':''} ${godMode?'divine':''} ${preferences.buddyMotion===false?'motion-off':''} accessory-${preferences.buddyAccessory||'clips'}`} style={companionStyle(preferences)} viewBox="0 0 240 200" aria-label={`${companionName(preferences)} is ${mood}`}><ellipse cx="120" cy="185" rx="76" ry="8" fill="#8075a5" opacity=".12"/><path d="M70 178 Q65 124 100 119 L145 119 Q180 139 173 179Z" fill="#8f81bf"/>{godMode&&<DivineCostume/>}<path d="M59 80 Q45 38 72 27 L82 12 103 26 Q160 5 181 45 Q204 83 175 121 L65 119Z" fill="#534555"/><ellipse cx="122" cy="85" rx="55" ry="53" fill="#f3d9cc"/><path d="M64 76 Q57 28 101 26 Q154 4 183 57 L178 88 160 56 151 65 142 43 115 65 104 49 79 80Z" fill="#534555"/><path d="M68 74 Q60 117 83 129 L80 89 M177 70 Q194 110 164 131 L164 91" fill="#534555"/><g className={`mascot-face ${['charged','overdrive','determined','proud','tired'].includes(mood)?'enhanced-face':''}`} transform={`translate(${mouse.x*10},${mouse.y*7})`}><path d={typing||mood==='happy'||mood==='ecstatic'?'M91 88 Q98 80 105 88 M137 88 Q144 80 151 88':(mood==='angry'||mood==='scary')?'M91 80 L106 88 M137 88 L152 80':'M96 83 L96 91 M145 83 L145 91'} stroke="#534555" strokeWidth="4" strokeLinecap="round" fill="none"/><path d={mood==='ecstatic'?'M110 100 Q122 123 135 100Z':mood==='sad'?'M114 108 Q122 100 130 108':mood==='shocked'?'M118 101 Q129 94 128 107 Q122 116 118 101':'M115 102 Q122 110 130 102'} fill={mood==='shocked'||mood==='ecstatic'?'#9f6570':'none'} stroke="#a66e78" strokeWidth="2.5" strokeLinecap="round"/><CompanionFace mood={mood}/></g><ellipse cx="87" cy="99" rx="10" ry="5" fill="#e6a1a7" opacity=".5"/><ellipse cx="157" cy="99" rx="10" ry="5" fill="#e6a1a7" opacity=".5"/>{mood==='sad'&&<path d="M96 98 Q89 111 96 113 Q104 111 96 98" fill="#8fc9e9"/>}<path d="M73 54 L80 51 M71 61 L80 58" stroke="#d8bc80" strokeWidth="3" strokeLinecap="round"/><CompanionDetails settings={preferences} divine={godMode}/><rect x="67" y="165" width="111" height="21" rx="5" fill="#ddd7e9" stroke="#beb4d4" strokeWidth="2"/><path d="M79 173 H165 M85 180 H156" stroke="#b5aacb" strokeWidth="3" strokeDasharray="8 4"/><g className="buddy-mouse" transform={mousing?`translate(${mouse.x*24},${mouse.y*16})`:undefined}><ellipse cx="191" cy="179" rx="15" ry="5" fill="#bcb1cf" opacity=".25"/><rect x="181" y="163" width="20" height="23" rx="10" fill="#e2d9f1" stroke="#b7a6cf" strokeWidth="1.5"/><path d="M191 164V173" stroke="#b7a6cf" strokeWidth="2"/></g><g className="buddy-left-arm"><path d="M85 145 Q78 155 96 167" stroke="#d9c8e7" strokeWidth="15" fill="none" strokeLinecap="round"/><ellipse cx="101" cy="169" rx="11" ry="7" fill="#f3d9cc"/><path d="M98 168V172 M103 168V172" stroke="#d8b7aa" strokeWidth="1.5" strokeLinecap="round"/></g><g className={`buddy-right-arm ${mousing?'using-mouse':''}`} transform={mousing?`translate(${mouse.x*24},${mouse.y*16})`:undefined}><path d={mousing?"M155 145 Q177 148 187 165":"M154 145 Q161 156 146 166"} stroke="#d9c8e7" strokeWidth="15" fill="none" strokeLinecap="round"/><ellipse cx={mousing?190:141} cy={mousing?167:169} rx="11" ry="7" fill="#f3d9cc"/><path d={mousing?"M187 166V170 M192 166V170":"M138 168V172 M143 168V172"} stroke="#d8b7aa" strokeWidth="1.5" strokeLinecap="round"/></g><circle cx="182" cy="130" r="14" fill="#eee7fa"/><path d="m176 131 4 4 8-9" stroke="#9a86ca" strokeWidth="2.5" fill="none" strokeLinecap="round"/></svg>}
function App(){
 const [settings,setSettings]=useState(()=>({...initialSettings,...read('keiko-settings',{})}));const [history,setHistory]=useState(()=>read('keiko-history',[]));const [page,setPage]=useState('practice');const [modal,setModal]=useState(null);const [mode,setMode]=useState('time');const [limit,setLimit]=useState(30);const [wordLimit,setWordLimit]=useState(25);const [custom,setCustom]=useState('');const [passage,setPassage]=useState('');const [typed,setTyped]=useState('');const [running,setRunning]=useState(false);const [remaining,setRemaining]=useState(30);const [result,setResult]=useState(null);const [focused,setFocused]=useState(true);const [key,setKey]=useState('');const [mouse,setMouse]=useState({x:0,y:0});const [toast,setToast]=useState('');const input=useRef(null);const start=useRef(null);const errors=useRef(0);const strokes=useRef(0);const soundRef=useRef(null);const finished=useRef(false);const samples=useRef([]);const fileInput=useRef(null);
 const lastActivity=useRef(null);const lastMistakeEvent=useRef(null);const sessionActions=useRef(null);
 const events=useRef([]);const typedRef=useRef('');const activityTimer=useRef(null);const pointerTimer=useRef(null);const lastPointer=useRef(0);const [typingActive,setTypingActive]=useState(false);const [report,setReport]=useState(null);const [,setClockSeconds]=useState(0);
 const [scrollOffset,setScrollOffset]=useState(0);const passageRef=useRef(null);
 useLayoutEffect(()=>{const marker=passageRef.current?.querySelector('.caret');const lineHeight=passageRef.current?parseFloat(getComputedStyle(passageRef.current).lineHeight):41;setScrollOffset(Math.max(0,(marker?.offsetTop||0)-lineHeight))},[typed,passage]);
 useEffect(()=>{if(!modal)return;const previous=document.activeElement;const dialog=document.querySelector('[role="dialog"]');dialog?.querySelector('button')?.focus();const trap=e=>{if(e.key!=='Tab')return;const controls=[...dialog.querySelectorAll('button,input,textarea')].filter(el=>!el.disabled);const first=controls[0],last=controls[controls.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}};document.addEventListener('keydown',trap);return()=>{document.removeEventListener('keydown',trap);previous?.focus()}},[modal]);
 const theme=THEMES.find(t=>t.id===settings.theme)||THEMES[0];const update=(v)=>setSettings(s=>({...s,...v}));
 useEffect(()=>{try{localStorage.setItem('keiko-settings',JSON.stringify(settings))}catch{setToast('Browser storage is unavailable. Export a backup to keep your progress.')}},[settings]);useEffect(()=>{try{localStorage.setItem('keiko-history',JSON.stringify(history))}catch{setToast('Browser storage is full. Export a backup to keep your progress.')}},[history]);
 const generate=()=>{if(mode==='custom')return custom.trim()||'Make time for the things that make you feel alive. Find your rhythm and let the words flow.';if(mode==='quote')return QUOTES[Math.floor(Math.random()*QUOTES.length)];let a=Array.from({length:mode==='words'?wordLimit:180},()=>WORDS[Math.floor(Math.random()*WORDS.length)]);if(settings.numbers)a=a.map((w,i)=>i%9===7?String(Math.floor(Math.random()*1000)):w);if(settings.punctuation)a=a.map((w,i)=>i%8===0?w[0].toUpperCase()+w.slice(1):i%8===7?w+'.':w);return a.join(' ')};
 const reset=()=>{setPassage(generate());setTyped('');setRemaining(limit);setRunning(false);setResult(null);start.current=null;lastActivity.current=null;lastMistakeEvent.current=null;typedRef.current='';events.current=[];errors.current=0;strokes.current=0;finished.current=false;samples.current=[];clearTimeout(activityTimer.current);setTypingActive(false);setClockSeconds(0);if(modal==='results')setModal(null);setTimeout(()=>input.current?.focus(),30)};
 useEffect(()=>{reset()},[mode,limit,wordLimit,settings.punctuation,settings.numbers]);
 const elapsed=()=>Math.max((Date.now()-start.current)/1000,1);const correct=useMemo(()=>[...typed].filter((c,i)=>c===passage[i]).length,[typed,passage]);const wpm=running?Math.round(correct/5/(elapsed()/60)):0;const accuracy=strokes.current?Math.max(0,Math.round((1-errors.current/strokes.current)*100)):100;
 // GOD MODE observes the session only: it never owns the clock, input, or saved preferences.
 const godMode=useGodMode({running,wpm,correct,errors:errors.current,elapsed:running?elapsed():0,history,events:events.current});
 const finish=(value=typed,reason='completed')=>{if(finished.current)return;finished.current=true;const seconds=mode==='time'?Math.min(limit,elapsed()):mode==='free'&&reason==='idle'?Math.max(1,(lastActivity.current-start.current)/1000+.001):elapsed();const count=[...value].filter((c,i)=>c===passage[i]).length;const entry={id:Date.now(),date:new Date().toISOString(),wpm:Math.round(count/5/(seconds/60)),raw:Math.round(strokes.current/5/(seconds/60)),accuracy:strokes.current?Math.max(0,Math.round((1-errors.current/strokes.current)*100)):100,seconds:Math.round(seconds),duration:seconds,mode,endReason:reason,characters:count,errors:errors.current,samples:samples.current,timeline:buildTimeline(events.current,seconds)};setResult(entry);setReport(entry);setModal('results');setRunning(false);setTypingActive(false);clearTimeout(activityTimer.current);if(mode==='time')setRemaining(0);setHistory(h=>[entry,...h].slice(0,500));};
 sessionActions.current={finish,reset};
 useSessionClock({running,startTime:start.current,limit,mode,onTick:seconds=>{setClockSeconds(seconds);if(mode==='time')setRemaining(Math.max(0,Math.ceil(limit-seconds)));},lastActivity:lastActivity.current,idleSeconds:5,onExpire:reason=>finish(typedRef.current,reason)});
 useEffect(()=>()=>{clearTimeout(activityTimer.current);clearTimeout(pointerTimer.current)},[]);
 const trackMouse=e=>{const now=performance.now();if(now-lastPointer.current<32)return;lastPointer.current=now;setMouse({x:e.clientX/window.innerWidth-.5,y:e.clientY/window.innerHeight-.5,active:true});clearTimeout(pointerTimer.current);pointerTimer.current=setTimeout(()=>setMouse(m=>({...m,active:false})),650);};
 useEffect(()=>{const handler=e=>{if(e.key==='Tab'&&e.shiftKey&&!modal&&document.activeElement===input.current){e.preventDefault();sessionActions.current.reset()}if((e.metaKey||e.ctrlKey)&&e.key==='1'){e.preventDefault();setPage('practice')}if(e.key==='Escape'){if(modal){setModal(null);}else if(mode==='free'&&running&&!finished.current){e.preventDefault();sessionActions.current.finish(typedRef.current,'escape');}} };window.addEventListener('keydown',handler);return()=>window.removeEventListener('keydown',handler)},[mode,limit,wordLimit,custom,modal,running]);
 const play=()=>{if(settings.sound==='Off')return;if(godMode.active){playGodKey(soundRef,settings.volume);return;}try{const ctx=soundRef.current||(soundRef.current=new(window.AudioContext||window.webkitAudioContext)());if(ctx.state==='suspended')ctx.resume();const osc=ctx.createOscillator();const gain=ctx.createGain();osc.connect(gain);gain.connect(ctx.destination);const frequencies={'Mechanical':190,'Bubble pop':650,'Dark coder':95,'Retro arcade':420,'Shōnen':820,'Soft rain':1200};osc.type=settings.sound==='Retro arcade'?'square':settings.sound==='Mechanical'?'triangle':'sine';osc.frequency.setValueAtTime(frequencies[settings.sound]||300,ctx.currentTime);osc.frequency.exponentialRampToValueAtTime(45,ctx.currentTime+.065);gain.gain.setValueAtTime(settings.volume/100*.15,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.075);osc.start();osc.stop(ctx.currentTime+.08);if(['Mechanical','Dark coder','Soft rain'].includes(settings.sound)){const buffer=ctx.createBuffer(1,Math.ceil(ctx.sampleRate*.055),ctx.sampleRate);const data=buffer.getChannelData(0);for(let i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*Math.exp(-i/(ctx.sampleRate*.009));const noise=ctx.createBufferSource();noise.buffer=buffer;const filter=ctx.createBiquadFilter();filter.type='highpass';filter.frequency.value=settings.sound==='Soft rain'?2200:600;const clickGain=ctx.createGain();clickGain.gain.value=settings.volume/100*(settings.sound==='Dark coder'?.12:.24);noise.connect(filter);filter.connect(clickGain);clickGain.connect(ctx.destination);noise.start()}}catch{}};
 const change=e=>{
   if(result||finished.current)return;
   const now=Date.now();
   if(mode==='time'&&timeExpired(start.current,now,limit)){finish(typedRef.current,'timer');return;}
   if(mode==='free'&&start.current!==null&&idleRemaining(lastActivity.current,now)===0){finish(typedRef.current,'idle');return;}
   const value=e.target.value;
   if(value.length>typedRef.current.length){
     if(start.current===null){start.current=now;setRunning(true);}
     const from=typedRef.current.length;
     strokes.current+=value.length-from;
     for(let i=from;i<value.length;i++){
       const correct=value[i]===passage[i];
       if(!correct)errors.current++;
       const attempt={at:(now-start.current)/1000,correct,actual:value[i],expected:passage[i]};events.current.push(attempt);if(!correct)lastMistakeEvent.current=attempt;
     }
     play();
   }
   lastActivity.current=now;typedRef.current=value;setTyped(value);
   setTypingActive(true);clearTimeout(activityTimer.current);activityTimer.current=setTimeout(()=>setTypingActive(false),350);
   if(mode==='free'){if(passage.length-value.length<160)setPassage(p=>p+' '+generate());}else if(value.length>=passage.length)finish(value);
 };
 const announce=t=>{setToast(t);setTimeout(()=>setToast(''),3500)};
 const exportData=()=>{const blob=new Blob([JSON.stringify({version:1,history,settings},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='keiko-progress.json';a.click();URL.revokeObjectURL(a.href);announce('Your progress is ready to take with you.')};
 const importData=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data.history)||!data.history.every(x=>Number.isFinite(x.wpm)&&Number.isFinite(x.accuracy)&&typeof x.date==='string'&&Number.isFinite(Date.parse(x.date))&&Number.isFinite(x.seconds)&&x.seconds>=0&&Number.isFinite(x.id)&&x.wpm>=0&&x.accuracy>=0&&x.accuracy<=100))throw Error();setHistory(h=>[...new Map([...data.history,...h].map(x=>[x.id,x])).values()].sort((a,b)=>b.id-a.id).slice(0,500));announce('Progress imported. Welcome back!')}catch{announce('That file doesn’t look like a Keiko backup.')}e.target.value=''};
 const best=Math.max(0,...history.map(x=>x.wpm));const average=history.length?Math.round(history.reduce((a,b)=>a+b.wpm,0)/history.length):0;const totalMinutes=Math.round(history.reduce((a,b)=>a+b.seconds,0)/60);const streak=(()=>{let n=0;let d=new Date();const days=new Set(history.map(h=>new Date(h.date).toDateString()));if(!days.has(d.toDateString()))d.setDate(d.getDate()-1);while(days.has(d.toDateString())){n++;d.setDate(d.getDate()-1)}return n})();
 const name=companionName(settings);
 const lastMistake=lastMistakeEvent.current;
 const reaction=getCompanionReaction({running,result,god:godMode.active,power:godMode.power,wpm,baseline:godMode.baseline,accuracy,recentMistake:running&&lastMistake&&(elapsed()-lastMistake.at)<2,typing:typingActive,settings});
 const mood=reaction.mood,buddyMessage=reaction.message;
 const idleLeft=mode==='free'&&running?idleRemaining(lastActivity.current,Date.now()):5;
 const sessionTime=running?Math.floor(Math.max(0,(Date.now()-start.current)/1000)):0;
 const sessionClock=Math.floor(sessionTime/60)+':'+String(sessionTime%60).padStart(2,'0');
 const darkPalette=settings.dark||['batman','neon','hacker','iron','retro'].includes(theme.id);
 const accent=/^#[0-9a-f]{6}$/i.test(settings.accent)?settings.accent:theme.color;
 const css={'--bg':settings.dark?'#191820':theme.bg,'--panel':settings.dark?'#24222e':theme.panel,'--text':settings.dark?'#e9e5f0':theme.text,'--accent':accent,'--muted':darkPalette?'#b7b0c3':'#767080','--border':darkPalette?'#45414c':'#e9e5ef'};
 const passageMarkup=useMemo(()=>[...passage].map((c,i)=><span key={i} className={`${i<typed.length?(typed[i]===c?'correct':'incorrect'):''} ${i===typed.length?'caret':''}`}>{c}</span>),[passage,typed]);
 return <div className={`app theme-${theme.id} ${settings.dark?'dark':''} ${godMode.active?'god-mode-active':''}`} style={{...css,...(godMode.active?GOD_MODE_PALETTE:{}),'--god-power':godMode.power,'--scatter-target':godMode.power}} onMouseMove={trackMouse}>
 <GodModeEffects mode={godMode} soundRef={soundRef} settings={settings}/>
 <aside className="sidebar"><a href="#" className="brand" onClick={e=>{e.preventDefault();setPage('practice')}}><span className="brand-icon"><Keyboard size={23}/></span><KineticText text="keiko" active={godMode.active} power={godMode.power}/><span className="brand-dot">.</span></a><div className="workspace-label"><KineticText text="YOUR LITTLE FOCUS SPACE" active={godMode.active} power={godMode.power}/></div><nav>{[['practice',Keyboard,'Typing practice'],['analytics',BarChart3,'Your progress'],['themes',Palette,'Look & feel']].map(([id,Icon,label])=><button className={page===id?'nav-item active':'nav-item'} onClick={()=>setPage(id)} key={id}><Icon size={19}/><KineticText text={label} active={godMode.active} power={godMode.power}/>{id==='practice'&&<span className="nav-shortcut">⌘ 1</span>}{id==='themes'&&<span className="new-dot"/>}</button>)}<button className="nav-item" onClick={()=>setModal('buddy')}><Sparkles size={19}/> Companion studio</button></nav><div className="sidebar-note"><span className="tiny-stars">✧</span><p><KineticText text="A little practice." active={godMode.active} power={godMode.power}/><br/><KineticText text="A little progress." active={godMode.active} power={godMode.power}/><br/><strong><KineticText text="A better you." active={godMode.active} power={godMode.power}/></strong></p><div className="note-line"/></div><div className="sidebar-bottom"><button className="nav-item" onClick={()=>setModal('settings')}><Settings size={18}/> Settings</button><div className="local-status"><span/> Saved on this device <span className="status-lock">↗</span></div><div className="profile"><div className="avatar">Y</div><div><strong>Your space</strong><small>Make yourself at home</small></div><button className="icon-button" aria-label="Toggle dark mode" onClick={()=>update({dark:!settings.dark})}>{settings.dark?<Moon size={17}/>:<Sun size={17}/>}</button></div></div></aside>
 <div className="main-shell"><header><div className="breadcrumb">Your space <span>/</span> <strong>{page==='practice'?'Typing practice':page==='analytics'?'Your progress':'Look & feel'}</strong></div><div className="header-right"><span className="streak"><Flame size={15}/>{streak} day streak</span><span className="header-divider"/><button className="icon-button" aria-label="Sound settings" onClick={()=>setModal('sound')}>{settings.sound==='Off'?<VolumeX size={18}/>:<Volume2 size={18}/>}</button><button className="icon-button" aria-label="Switch color mode" onClick={()=>update({dark:!settings.dark})}>{settings.dark?<Moon size={18}/>:<Sun size={18}/>}</button><div className="small-avatar">Y</div></div></header>
 <main>{page==='practice'?<><div className="page-heading"><div><div className="eyebrow"><span/> A LITTLE BETTER, EVERY DAY</div><h1><KineticText text="Find your flow" active={godMode.active} power={godMode.power}/><span>.</span></h1><p><KineticText text="Clear your mind. Feel the keys. Let the words follow." active={godMode.active} power={godMode.power}/></p></div><button className="soft-button" onClick={()=>setPage('themes')}><Palette size={16}/><span>{theme.name}</span><ChevronDown size={14}/></button></div>
 <GodModeControl mode={godMode} running={running}/>
 <div className={`practice-layout ${settings.buddy?'':'without-companion'}`}><section className="typing-card"><div className="test-toolbar"><div className="mode-tabs">{[['time',Clock3,'time'],['words',BookOpen,'words'],['quote',Command,'quote'],['custom',Settings,'custom'],['free',Sparkles,'untimed']].map(([id,Icon,label])=><button key={id} className={mode===id?'selected':''} onClick={()=>setMode(id)}><Icon size={14}/>{label}</button>)}</div><div className="toolbar-divider"/><div className="test-options"><button className={settings.punctuation?'selected':''} title="Toggle punctuation" onClick={()=>update({punctuation:!settings.punctuation})}>@ <span>punctuation</span></button><button className={settings.numbers?'selected':''} title="Toggle numbers" onClick={()=>update({numbers:!settings.numbers})}># <span>numbers</span></button></div></div>
 <div className="test-content"><div className="session-meta"><div className="duration-options">{mode==='time'?[15,30,60,120].map(n=><button className={limit===n?'selected':''} onClick={()=>setLimit(n)} key={n}>{n}</button>):mode==='words'?[10,25,50,100].map(n=><button className={wordLimit===n?'selected':''} onClick={()=>setWordLimit(n)} key={n}>{n}</button>):mode==='free'?<div className="free-session-info"><strong>No time limit</strong><span><kbd>esc</kbd> finish</span><span>5s idle ends session</span></div>:<span>{mode==='quote'?'A little food for thought':'Your words, your practice'}</span>}<span className="unit-label">{mode==='time'?'seconds':mode==='words'?'words':''}</span></div><button className="icon-button" title="Focus typing area" onClick={()=>input.current?.focus()}><Maximize2 size={16}/></button></div>
 {mode==='custom'&&!running&&!result&&<div className="custom-entry"><input value={custom} onChange={e=>setCustom(e.target.value)} placeholder="Paste or write something to practice…" aria-label="Custom practice text"/><button onClick={reset}>Apply</button></div>}
 {result?<div className="result"><span className="eyebrow">A LITTLE MORE PROGRESS</span><h2>{result.accuracy>=95?'Beautifully done.':'Keep showing up.'} <Sparkles size={25}/></h2><div className="result-stats"><div><strong>{result.wpm}</strong><span>words per minute</span></div><div><strong>{result.accuracy}<small>%</small></strong><span>accuracy</span></div><div><strong>{result.seconds}<small>s</small></strong><span>time typing</span></div></div><p>{result.characters} correct characters · {result.errors} errors · {result.raw} raw WPM</p><button className="text-button match-reopen" onClick={()=>{setReport(result);setModal('results')}}><BarChart3 size={15}/> View match breakdown</button><button className="primary-button" onClick={reset}>Find your flow again <ArrowRight size={16}/></button></div>:<><div className="live-metrics"><div><span className="live-time">{mode==='time'?remaining:mode==='free'?sessionClock:Math.max(0,passage.split(' ').length-typed.split(' ').length+1)}</span><span className="metric-caption">{mode==='time'?'seconds left':mode==='free'?'time in the flow':'words left'}</span></div><div className="live-secondary"><span><strong>{wpm}</strong> wpm</span><span><strong>{accuracy}</strong>% acc</span></div></div><div className={`typing-area ${!focused?'unfocused':''}`} onClick={()=>input.current?.focus()}><div className="passage" ref={passageRef} id="practice-passage" style={{transform:`translateY(-${scrollOffset}px)`}}>{passageMarkup}</div><textarea ref={input} value={typed} onChange={change} onFocus={()=>setFocused(true)} onBlur={()=>setFocused(false)} onPaste={e=>e.preventDefault()} onKeyDown={e=>{setKey(e.key.toLowerCase());setTimeout(()=>setKey(''),130)}} spellCheck="false" autoComplete="off" autoCapitalize="off" aria-label="Typing test. Type the displayed passage." aria-describedby="practice-passage"/>{!focused&&<div className="focus-overlay"><Keyboard size={17}/> Click here to find your focus</div>}</div>{mode==='free'&&<div className={`free-idle-hint ${running&&idleLeft<4?'is-counting':''}`}>{running&&idleLeft<4?<><span>Session ends in {Math.ceil(idleLeft)}s · keep typing to continue</span><span className="free-idle-track"><i style={{width:`${idleLeft/5*100}%`}}/></span></>:<span>No rush. Press Escape when you’re done.</span>}</div>}<div className="typing-hint">{running?<><span className="pulsing-dot"/> Looking good. Keep your rhythm.</>:<>Start typing to begin your journey <span>↵</span></>}</div></>}
 </div><div className="test-bottom"><span><span className="status-dot"/> {result?'Practice complete':running?'In your flow':'Ready when you are'}</span><button className="restart-button" onClick={reset}><RotateCcw size={15}/><span>restart test</span><kbd>shift</kbd> + <kbd>tab</kbd></button><button className="icon-button" aria-label="Test settings" onClick={()=>setModal('settings')}><Settings size={16}/></button></div></section>
 {settings.buddy&&<aside className="buddy-card"><div className="buddy-label"><span className="buddy-dot"/> YOUR TYPING COMPANION<button className="icon-button" aria-label="Companion settings" onClick={()=>setModal('buddy')}><Settings size={14}/></button></div><div className="mascot-stage"><span className="floating-star star-one">✧</span><span className="floating-star star-two">✧</span><Mascot mood={mood} typing={running&&typingActive} mouse={mouse} mousing={mouse.active&&!typingActive} godMode={godMode.active} preferences={settings}/></div><h3>{godMode.active?`${name}, ascended`:`Hey, I’m ${name}`} <span>✿</span></h3><p>Your tiny cheerleader.<br/>Your biggest fan.</p><span className="reaction-badge">{reaction.label}</span><div className="speech-bubble">{buddyMessage}</div><div className="buddy-footer" aria-live="polite"><Heart size={12}/> {running&&typingActive?'Typing right along with you':mouse.active?'Mouse buddy mode':'Here for your training arc'}</div></aside>}</div>
 {settings.keyboard&&<section className={`keyboard-section ${settings.buddy?'':'full-width'}`}><div className="section-top"><span><Keyboard size={15}/> A little rhythm at your fingertips</span><button onClick={()=>update({keyboard:false})}>hide keyboard <ChevronDown size={13}/></button></div><div className="keyboard">{['`1234567890-=','qwertyuiop[]\\',"asdfghjkl;'",'zxcvbnm,./'].map((row,i)=><div className="key-row" key={i}>{i>0&&<div className="key key-wide">{['','tab','caps','shift'][i]}</div>}{[...row].map(k=><div key={k} className={`key ${key===k?'pressed':''} ${'fj'.includes(k)?'home-key':''}`}>{k}</div>)}<div className="key key-wide">{['delete','⌫','return','shift'][i]}</div></div>)}<div className="key-row"><div className="key key-wide">ctrl</div><div className="key">fn</div><div className="key">alt</div><div className="key">⌘</div><div className={`key space-key ${key===' '?'pressed':''}`}/><div className="key">⌘</div><div className="key">alt</div><div className="key key-wide">ctrl</div></div></div></section>}
 <div className="insights-heading"><h2>Your little wins</h2><button onClick={()=>setPage('analytics')}>See your progress <ArrowUpRight size={14}/></button></div><div className="stat-grid"><Stat icon={Zap} label="Personal best" value={best||'—'} unit="wpm" detail={history.length?'Your fastest flow yet':'Your first win is waiting'} color="purple"/><Stat icon={Target} label="Average accuracy" value={history.length?Math.round(history.reduce((a,b)=>a+b.accuracy,0)/history.length):'—'} unit="%" detail="Precision over perfection" color="green"/><Stat icon={Clock3} label="Time in the flow" value={totalMinutes} unit="min" detail="Every minute is an investment" color="peach"/></div></>:page==='analytics'?<><div className="page-heading"><div><div className="eyebrow">GROW AT YOUR OWN PACE</div><h1>Your progress<span>.</span></h1><p>Small steps add up. Here’s the proof.</p></div><button className="soft-button" onClick={exportData}><Download size={16}/> Export progress</button></div><div className="stat-grid analytics-stats"><Stat icon={Zap} label="Personal best" value={best||'—'} unit="wpm" detail={`${history.length} tests completed`} color="purple"/><Stat icon={BarChart3} label="Average speed" value={average||'—'} unit="wpm" detail="Across all your sessions" color="green"/><Stat icon={Flame} label="Current streak" value={streak} unit="days" detail="A little better, every day" color="peach"/></div><section className="chart-card"><div className="section-title"><div><h2>Your rhythm, over time</h2><p>Words per minute · Last 20 sessions</p></div><span className="chart-legend"><i/> Typing speed</span></div>{history.length>1?<div className="chart"><div className="chart-y">{[Math.max(best,100),Math.round(Math.max(best,100)/2),0].map(n=><span key={n}>{n}</span>)}</div><svg viewBox="0 0 900 200" preserveAspectRatio="none" role="img" aria-label="Words per minute over the last twenty typing sessions"><defs><linearGradient id="fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="var(--accent)" stopOpacity=".3"/><stop offset="100%" stopColor="var(--accent)" stopOpacity="0"/></linearGradient></defs>{[15,100,185].map(y=><line key={y} x1="0" x2="900" y1={y} y2={y} stroke="var(--border)" strokeDasharray="4 5"/>)}<polygon points={`0,200 ${history.slice(0,20).reverse().map((h,i,a)=>`${i/(a.length-1)*900},${185-h.wpm/Math.max(best,100)*170}`).join(' ')} 900,200`} fill="url(#fill)"/><polyline points={history.slice(0,20).reverse().map((h,i,a)=>`${i/(a.length-1)*900},${185-h.wpm/Math.max(best,100)*170}`).join(' ')} fill="none" stroke="var(--accent)" strokeWidth="3" strokeLinejoin="round"/></svg></div>:<div className="empty-state"><BarChart3 size={30}/><h3>Your story starts with a keystroke.</h3><p>Complete two tests to see your progress take shape.</p><button className="primary-button" onClick={()=>setPage('practice')}>Let’s practice <ArrowRight size={16}/></button></div>}</section><section className="history-card"><div className="section-title"><h2>Practice journal</h2><button className="text-button" onClick={()=>fileInput.current.click()}><Upload size={14}/> Import backup</button></div>{history.length?<div className="table-wrap"><table><thead><tr><th>SESSION</th><th>SPEED</th><th>ACCURACY</th><th>DURATION</th><th>MODE</th><th>BREAKDOWN</th></tr></thead><tbody>{history.slice(0,20).map(h=><tr key={h.id}><td>{new Date(h.date).toLocaleString(undefined,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})}</td><td><strong>{h.wpm}</strong> wpm {h.wpm===best&&<Trophy size={13}/>}</td><td>{h.accuracy}%</td><td>{h.seconds}s</td><td><span className="mode-badge">{h.mode==='free'?'untimed':h.mode}</span></td><td><button className="text-button" aria-label={`View match from ${new Date(h.date).toLocaleString()}`} onClick={()=>{setReport(h);setModal('results')}}><BarChart3 size={14}/> View graph</button></td></tr>)}</tbody></table></div>:<div className="empty-journal">A fresh page. Your completed tests will appear here.</div>}</section><div className="privacy-note"><Heart size={14}/> Just for you. Your progress stays in this browser. Export a backup anytime.</div></>:<><div className="page-heading"><div><div className="eyebrow">MAKE YOURSELF AT HOME</div><h1>A space that’s you<span>.</span></h1><p>A new mood. A different rhythm. Your perfect little corner.</p></div><button className="soft-button" onClick={()=>setModal('sound')}><Volume2 size={16}/> Sound studio</button></div><div className="theme-controls"><div><h2>Pick your atmosphere</h2><p>Made for whatever mood you’re in.</p></div><div className="segmented"><button className={!settings.dark?'active':''} onClick={()=>update({dark:false})}><Sun size={14}/> Light</button><button className={settings.dark?'active':''} onClick={()=>update({dark:true})}><Moon size={14}/> Dark</button></div></div><div className="theme-grid">{THEMES.map(t=><button className={`theme-card ${settings.theme===t.id?'chosen':''}`} key={t.id} onClick={()=>update({theme:t.id,dark:false,accent:''})}><div className={`theme-preview preview-${t.id}`} style={{background:t.bg,color:t.color}}><div className="mini-sidebar"><div/><div/><div/></div><div className="mini-content"><div className="mini-title"/><div className="mini-panel" style={{background:t.panel}}><span>find your flow<span className="mini-caret">|</span></span><i/><i/></div><div className="mini-boxes"><i style={{background:t.panel}}/><i style={{background:t.panel}}/><i style={{background:t.panel}}/></div></div>{settings.theme===t.id&&<span className="theme-check"><Check size={14}/></span>}</div><div className="theme-card-label"><div><strong>{t.name}</strong><small>{t.sub}</small></div><span style={{background:t.color}}/></div></button>)}</div><section className="color-card"><div><h2>A color of your own</h2><p>Fine-tune your accent with any RGB or hex color.</p></div><div className="color-controls"><input type="color" aria-label="Custom accent color" value={settings.accent||theme.color} onChange={e=>update({accent:e.target.value})}/><input aria-label="Hex accent color" value={settings.accent||theme.color} onChange={e=>{if(/^#[0-9a-f]{0,6}$/i.test(e.target.value))update({accent:e.target.value})}} maxLength={7}/><button className="text-button" onClick={()=>update({accent:''})}>Reset</button></div></section></>}
 <footer><span>Made for the joy of getting a little better.</span><span><kbd>shift</kbd> + <kbd>tab</kbd> restart <i/> <Heart size={12}/> Take it at your own pace.</span></footer></main></div>
 <input ref={fileInput} type="file" accept="application/json" hidden onChange={importData}/>
 {modal==='buddy'&&<CompanionStudio settings={settings} update={update} onClose={()=>setModal(null)} renderCompanion={props=><Mascot {...props}/>}/>}
 {modal==='results'&&report&&<MatchAnalytics result={report} onClose={()=>setModal(null)} onRetry={()=>{setModal(null);setPage('practice');reset()}}/>}
 {modal&&modal!=='results'&&modal!=='buddy'&&<div className="modal-backdrop" onClick={()=>setModal(null)}><section className="modal" role="dialog" aria-modal="true" aria-label={modal==='sound'?'Sound studio':modal==='buddy'?'Meet your companion':'Settings'} onClick={e=>e.stopPropagation()}><button className="modal-close icon-button" aria-label="Close dialog" onClick={()=>setModal(null)}><X size={19}/></button><div className="eyebrow">YOUR SPACE, YOUR RULES</div><h2>{modal==='sound'?'Find your sound.':modal==='buddy'?'Meet your companion.':'The little details.'}</h2><p className="modal-intro">{modal==='sound'?'A satisfying little soundtrack for every keystroke.':'Make your practice feel a little more like you.'}</p>{modal==='sound'?<><div className="sound-list">{SOUNDS.map(s=><button key={s} className={settings.sound===s?'active':''} onClick={()=>{update({sound:s})}}><span>{s==='Off'?<VolumeX size={17}/>:<Volume2 size={17}/>} {s}</span>{settings.sound===s?<Check size={16}/>:<span className="sound-wave">▂ ▅ ▃ ▆ ▂</span>}</button>)}</div><label className="volume-label">Volume <span>{settings.volume}%</span><input type="range" min="0" max="100" value={settings.volume} onChange={e=>update({volume:Number(e.target.value)})}/></label><button className="primary-button full" onClick={play}><Volume2 size={16}/> Preview sound</button></>:<><Toggle title="Keiko, your companion" detail="A little encouragement while you type" checked={settings.buddy} onChange={()=>update({buddy:!settings.buddy})}/><Toggle title="A little tough love" detail="Let Keiko roast you when your pace drops" checked={settings.roast} onChange={()=>update({roast:!settings.roast})}/><Toggle title="On-screen keyboard" detail="See every keystroke come to life" checked={settings.keyboard} onChange={()=>update({keyboard:!settings.keyboard})}/><Toggle title="Dark mode" detail="A gentler glow for late-night practice" checked={settings.dark} onChange={()=>update({dark:!settings.dark})}/><button className="settings-link" onClick={()=>setModal('sound')}><Volume2 size={17}/> Typing sound <span>{settings.sound} <ArrowRight size={15}/></span></button><div className="backup-actions"><button className="soft-button" onClick={exportData}><Download size={15}/> Export backup</button><button className="soft-button" onClick={()=>fileInput.current.click()}><Upload size={15}/> Import backup</button></div><p className="modal-footnote">Your settings and last 500 tests save automatically in this browser.</p></>}</section></div>}{toast&&<div className="toast" role="status"><Check size={17}/>{toast}</div>}
 </div>
}
function Stat({icon:Icon,label,value,unit,detail,color}){return <div className="stat-card"><div className={`stat-icon ${color}`}><Icon size={19}/></div><div><span className="stat-label">{label}</span><div className="stat-value">{value}<small>{unit}</small></div><p>{detail}</p></div><ArrowUpRight size={15} className="stat-arrow"/></div>}
function Toggle({title,detail,checked,onChange}){return <label className="toggle-row"><span><strong>{title}</strong><small>{detail}</small></span><input type="checkbox" checked={checked} onChange={onChange}/><span className="toggle-track"/></label>}
createRoot(document.getElementById('root')).render(<App/>);
